# Maintainer: I4C Studio <i4c.studio.dev@gmail.com>

pkgname=kansei
pkgver=0.1.0.r42.gf74e432
pkgrel=1
pkgdesc='Claude Code cockpit: terminal tabs plus a sidebar that edits Claude memory, MCP servers, agents, skills, hooks and settings'
arch=('x86_64')
url='https://github.com/I4cTime/kansei'
# Renamed from tsukue on 2026-11-03: pacman swaps the old package out.
conflicts=('tsukue')
replaces=('tsukue')
# The repo has no LICENSE file yet, so no licence text is installed.
license=('custom')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'libsoup3'
  'dbus'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
)
makedepends=('cargo' 'nodejs' 'pnpm' 'git')
optdepends=('claude-code: the CLI the terminal tabs run')
# Keep the symbol table so stacks the watchdog captures (eu-stack) name the
# Rust frames: makepkg must not strip, and build() turns off Cargo's own
# release-profile strip. No separate debug package.
options=('!debug' '!strip')
# Local build from the committed checkout. A release PKGBUILD would use the
# GitHub tarball instead, e.g.
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
source=("$pkgname::git+file:///home/i4ctime/Develop/lab/kansei"
        'kansei.desktop')
sha256sums=('SKIP'
            '858133a35d403e552c39e791dec1bde5d55ad3b9e3ce1d8b2c1ea98b2f7e4c5a')

pkgver() {
  cd "$pkgname"
  ( set -o pipefail
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  ) ||
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/$pkgname/src-tauri/target"
  # Cargo.toml's release profile has strip = true; keep symbols in the package.
  export CARGO_PROFILE_RELEASE_STRIP=false
  # Runs beforeBuildCommand (pnpm build) for the frontend, then a cargo
  # release build. No deb/rpm/AppImage bundles.
  pnpm tauri build --no-bundle -- --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 src-tauri/target/release/kansei "$pkgdir/usr/bin/kansei"
  install -Dm644 "$srcdir/kansei.desktop" "$pkgdir/usr/share/applications/kansei.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/kansei.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/kansei.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/kansei.png"
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
